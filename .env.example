# Copy to .env and fill in. Never commit .env; it is gitignored.

# --- Database -------------------------------------------------------------
# Local development (the Docker container in the README):
GENESIS_DATABASE_URL=postgresql+psycopg://genesis:genesis@localhost:5434/genesis
#
# Neon: copy the connection string from the project dashboard and change the
# scheme to postgresql+psycopg. Two things to get right:
#
#   sslmode=require   Neon refuses unencrypted connections.
#   direct endpoint   Use the direct host for Alembic, not the -pooler one.
#                     Migrations run DDL in a transaction, and a pooled
#                     connection in transaction mode cannot hold that reliably.
#                     Application traffic should use -pooler.
#
# GENESIS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/genesis?sslmode=require

# --- Models ---------------------------------------------------------------
# anthropic_api | claude_platform_aws | bedrock_mantle
GENESIS_MODEL_PLATFORM=anthropic_api

# Required for anthropic_api. Set a spend limit in the Anthropic console too:
# the limit is the backstop, not this file.
ANTHROPIC_API_KEY=

# Required only for the AWS platforms.
# AWS_REGION=us-east-1
# ANTHROPIC_AWS_WORKSPACE_ID=
